(* Review types — structured output from Claude code review via tool_use *)

type severity = [
  | Critical <json name="critical">
  | Warning <json name="warning">
  | Suggestion <json name="suggestion">
  | Nitpick <json name="nitpick">
  | Praise <json name="praise">
  | Other of string
] <json open_enum> <ocaml repr="classic">

type finding_category = [
  | Bug <json name="bug">
  | Security <json name="security">
  | Performance <json name="performance">
  | Style <json name="style">
  | Logic <json name="logic">
  | Error_handling <json name="error-handling">
  | Naming <json name="naming">
  | Documentation <json name="documentation">
  | Other of string
] <json open_enum> <ocaml repr="classic">

type finding = {
  path: string;
  ?line: int option;
  ?end_line: int option;
  severity: severity;
  category: finding_category;
  message: string;
  ?suggested_fix: string option;
}

type review_output = {
  summary: string;
  findings: finding list;
  ~overall_assessment <ocaml default="\"\"">: string;
}

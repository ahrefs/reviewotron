type review_record = {
  pr_number: int;
  head_sha: string;
  reviewed_at: string;
}

type push_review_record = {
  after_sha: string;
  reviewed_at: string;
}

type repo_state = {
  ~pr_reviews <ocaml default="[]">: review_record list;
  ~push_reviews <ocaml default="[]">: push_review_record list;
}

type state = {
  repos: (string * repo_state) list <json repr="object">;
}

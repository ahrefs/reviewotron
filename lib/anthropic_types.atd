type json <ocaml module="Yojson.Safe" t="t"> = abstract

type role = [
  | User <json name="user">
  | Assistant <json name="assistant">
] <ocaml repr="classic">

type message = {
  role: role;
  content: string;
}

type tool = {
  name: string;
  ?description: string nullable;
  input_schema: json;
}

type tool_choice = {
  type_ <json name="type">: string;
  name: string;
}

type req = {
  model: string;
  messages: message list;
  max_tokens: int;
  ?system: string nullable;
  ?tools: tool list option;
  ?tool_choice: tool_choice option;
}

type text_content = {
  text: string;
}

type tool_use_content = {
  id: string;
  name: string;
  input: json;
}

type content = [
  | Text <json name="text"> of text_content
  | ToolUse <json name="tool_use"> of tool_use_content
] <ocaml repr="classic"> <json adapter.ocaml="Atdgen_runtime.Json_adapter.Type_field">

type stop_reason = [
  | End_turn <json name="end_turn">
  | Max_tokens <json name="max_tokens">
  | Stop_sequence <json name="stop_sequence">
  | Tool_use <json name="tool_use">
] <ocaml repr="classic">

type usage = {
  input_tokens: int;
  output_tokens: int;
}

type error_detail = {
  type_ <json name="type">: string;
  message: string;
}

type response_message = {
  id: string;
  role: role;
  content: content list;
  model: string;
  usage: usage;
  ?stop_reason: stop_reason nullable;
}

type error_response = {
  type_ <json name="type">: string;
  error: error_detail;
}

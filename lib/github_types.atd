type commit_hash = string

type git_user = {
  name: string;
  email: string;
  ?username: string option;
}

type github_user = {
  login: string;
  id: int;
  url: string;
  html_url: string;
  avatar_url: string;
}

type label = {
  name: string;
}

type repository = {
  name: string;
  full_name: string;
  html_url <ocaml name="url"> : string;
  commits_url: string;
  contents_url: string;
  pulls_url: string;
  issues_url: string;
  compare_url: string;
}

type commit = {
  id: commit_hash;
  distinct: bool;
  message: string;
  timestamp: string;
  url: string;
  author: git_user;
  committer: git_user;
  added: string list;
  removed: string list;
  modified: string list;
}

type commit_pushed_notification = {
  ref <ocaml name="ref_">: string;
  before: commit_hash;
  after: commit_hash;
  ?base_ref: string nullable;
  created: bool;
  deleted: bool;
  forced: bool;
  commits: commit list;
  ?head_commit: commit nullable;
  repository: repository;
  compare: string;
  pusher: git_user;
  sender: github_user;
}

type pr_action = string

type pr_branch = {
  sha: commit_hash;
  ref <ocaml name="ref_">: string;
  label: string;
  ?repo: repository option;
  ?user: github_user nullable;
}

type pull_request = {
  number: int;
  title: string;
  ?body: string nullable;
  html_url: string;
  diff_url: string;
  state: string;
  user: github_user;
  head: pr_branch;
  base: pr_branch;
  ~draft <ocaml default="false">: bool;
  ~merged <ocaml default="false">: bool;
  ~labels <ocaml default="[]">: label list;
  ~comments <ocaml default="0">: int;
  additions: int;
  deletions: int;
  changed_files: int;
}

type installation = {
  id: int;
}

type pr_notification = {
  action: pr_action;
  number: int;
  pull_request: pull_request;
  repository: repository;
  sender: github_user;
  ?installation: installation option;
}

(* Types for GitHub API responses *)
type pull_request_file = {
  ?sha: string nullable;
  filename: string;
  status: string;
  additions: int;
  deletions: int;
  changes: int;
  blob_url: string;
  raw_url: string;
  contents_url: string;
  ?patch: string option;
  ?previous_filename: string option;
}

type diff_side = [ Left <json name="LEFT"> | Right <json name="RIGHT"> ] <ocaml repr="classic">

type review_event = [
  | Comment <json name="COMMENT">
  | Approve <json name="APPROVE">
  | Request_changes <json name="REQUEST_CHANGES">
] <ocaml repr="classic">

(* Types for posting reviews *)
type review_comment_req = {
  path: string;
  ?position: int option;
  ?line: int option;
  ?side: diff_side option;
  ?start_line: int option;
  ?start_side: diff_side option;
  body: string;
}

type create_review_req = {
  ?commit_id: string option;
  body: string;
  event: review_event;
  ~comments <ocaml default="[]">: review_comment_req list;
}

type commit_comment_req = {
  body: string;
  ?path: string option;
  ?position: int option;
  ?line: int option;
}

(* Minimal envelope for extracting repo URL from any webhook payload
   before full event parsing. Used for signature validation.
   Reuses the existing repository type — ATD ignores extra fields. *)
type webhook_envelope = {
  repository: repository;
}

type pull_request_file_list = pull_request_file list

(* GitHub Contents API response — used to fetch config files from repos *)
type content_api_response = {
  content: string;
  encoding: string;
  name: string;
  path: string;
}

(* GitHub App installation token exchange response *)
type installation_token_response = {
  token: string;
  expires_at: string;
}

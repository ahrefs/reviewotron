{
  "name": "@reviewotron/pi",
  "version": "0.1.0",
  "description": "Pi extension, tools, and skill for running Reviewotron from a local CLI binary.",
  "type": "module",
  "main": "./src/adapter.js",
  "exports": {
    ".": "./src/adapter.js",
    "./adapter": "./src/adapter.js",
    "./extension-core": "./src/extension-core.js"
  },
  "files": [

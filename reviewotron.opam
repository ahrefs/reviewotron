opam-version: "2.0"
version: "0.3.0"
synopsis: "Automated code review bot powered by Claude"
maintainer: ["José Nogueira <jose.nogueira@ahrefs.com>"]
authors: ["Ahrefs"]
license: "MIT"
homepage: "https://github.com/ahrefs/reviewotron"
doc: "https://github.com/ahrefs/reviewotron"
bug-reports: "https://github.com/ahrefs/reviewotron/issues"
depends: [
  "dune" {>= "3.13"}
  "ocaml" {>= "4.14"}
  "alcotest" {with-test}
  "base64"
  "cmdliner"
  "containers"
  "curl"
  "devkit" {= "dev"}
  "digestif"
  "extlib"
  "fmt"
  "lwt" {< "6.0"}
  "lwt_ppx" {< "6.0"}
  "melange-json-native"
  "mirage-crypto-pk" {< "2.1.0"}
  "ocaml-ai-sdk" {>= "0.5"}
  "opentelemetry"
  "opentelemetry-lwt"
  "opentelemetry-client-ocurl-lwt"
  "mirage-crypto-rng" {< "2.1.0"}
  "ppx_deriving_jsonschema" {>= "0.0.8"}
  "ptime"
  "ocamlformat" {= "0.29.0"}
  "re2"
  "x509"
  "yojson"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/ahrefs/reviewotron.git"
pin-depends: [
  ["devkit.dev" "https://github.com/ahrefs/devkit/archive/8319a1419088506ac2862c444f62bf60ccfa34d6.tar.gz"]
]

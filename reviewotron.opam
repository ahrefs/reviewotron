# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.20.1"
synopsis: "Automated code review bot powered by Claude"
maintainer: ["José Nogueira <jose.nogueira@ahrefs.com>"]
authors: ["Ahrefs"]
license: "MIT"
homepage: "https://github.com/ahrefs/reviewotron"
doc: "https://github.com/ahrefs/reviewotron"
bug-reports: "https://github.com/ahrefs/reviewotron/issues"
depends: [
  "dune" {>= "3.13"}
  "ocaml" {>= "4.14"}
  "alcotest" {with-test}
  "base64"
  "cmdliner"
  "containers"
  "curl"
  "devkit" {>= "1.20260908"}
  "digestif"
  "extlib"
  "fmt"
  "lwt" {>= "6.0"}
  "lwt_ppx" {>= "6.0"}
  "jsonkit" {>= "1.1.0"}
  "mirage-crypto-pk"
  "ocaml-ai-sdk" {>= "0.9"}
  "opentelemetry"
  "opentelemetry-lwt"
  "opentelemetry-client-ocurl-lwt"
  "mirage-crypto-rng"
  "ptime"
  "ocamlformat" {= "0.29.0"}
  "re2"
  "x509"
  "yojson"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/ahrefs/reviewotron.git"

(executable
 (name reviewotron)
 (public_name reviewotron)
 (libraries
  reviewotron_lib
  cmdliner
  devkit
  devkit.core
  extlib
  lwt.unix
  unix
  mirage-crypto-rng.unix)
 (preprocess
  (pps lwt_ppx)))

; The CLI version is baked in at build time. Release/install builds
; (--profile=release) stamp the version declared in dune-project; every other
; build reports "dev" so local development is never mistaken for a release.

(rule
 (targets build_info.ml)
 (enabled_if
  (= %{profile} release))
 (action
  (with-stdout-to
   %{targets}
   (echo "let version = \"%{version:reviewotron}\""))))

(rule
 (targets build_info.ml)
 (enabled_if
  (<> %{profile} release))
 (action
  (with-stdout-to
   %{targets}
   (echo "let version = \"dev\""))))

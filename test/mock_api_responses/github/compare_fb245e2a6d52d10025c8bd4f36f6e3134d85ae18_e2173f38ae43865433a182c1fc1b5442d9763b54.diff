diff --git a/backend/lib/string_utils.ml b/backend/lib/string_utils.ml
new file mode 100644
index 0000000..1234567
--- /dev/null
+++ b/backend/lib/string_utils.ml
@@ -0,0 +1,15 @@
+let trim_and_lower s =
+  String.lowercase_ascii (String.trim s)
+
+let split_on_first_char c s =
+  match String.index_opt s c with
+  | None -> (s, "")
+  | Some i ->
+    let left = String.sub s 0 i in
+    let right = String.sub s (i + 1) (String.length s - i - 1) in
+    (left, right)
+
+let is_blank s =
+  String.length (String.trim s) = 0
+
+let truncate ~max_len s =
+  if String.length s <= max_len then s
+  else String.sub s 0 max_len ^ "..."

+      let%lwt body = Dream.body request in
+      let%lwt result = Db.update_document ~id ~body in
+      (match result with
+      | Ok () -> Dream.respond (Printf.sprintf "updated by %s" user.id)
+      | Error msg -> Dream.respond ~status:`Internal_Server_Error msg))
